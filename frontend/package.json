{
  "name": "paperless-searchbar-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/pdf-assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/pdf-assets.mjs && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "format:check": "prettier --check src tests e2e scripts *.ts *.json index.html"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
