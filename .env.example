# Copy to .env. Never commit real tokens or secrets.
APP_URL=http://localhost:8000
# Internal trusted Paperless endpoint; OIDC documents use the configured user header.
# Enable PAPERLESS_ENABLE_HTTP_REMOTE_USER_API in Paperless and strip the matching
# header at its public proxy. See README. The token also needs auth.view_user for OIDC.
PAPERLESS_URL=http://paperless:8000
PAPERLESS_PUBLIC_URL=https://paperless.example.com
# Same Django request.META name as in Paperless; HTTP_X_AUTH_USER sends X-Auth-User.
PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME=HTTP_REMOTE_USER
# Metadata and guest filter cache lifetime: 0 disables caching, maximum 300 seconds.
PAPERLESS_CACHE_TTL_SECONDS=300
PAPERLESS_TOKEN=replace-with-a-read-only-paperless-token
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:////data/searchbar.db
# Optional OIDC. Exact issuer from the provider's discovery document.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Trust only the reverse proxy's IP or network, never arbitrary forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1
# Docker secrets can override the corresponding values above:
# SECRET_KEY_FILE=/run/secrets/searchbar_key
# PAPERLESS_TOKEN_FILE=/run/secrets/paperless_token
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_secret
